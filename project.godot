; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ship_game_jam"
run/main_scene="res://Scene/Main/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

SceneTransition="*res://Autolaud/SceneTransition/scene_transition.tscn"
InputManager="*res://Autolaud/InputManager/InputManager.gd"
Settings="*res://Autolaud/Settings/Settings.gd"
MainMusic="*res://Autolaud/MainMusic/main_music.tscn"
HairborLayer="*res://Autolaud/hairbor_layer/hairbor_layer.tscn"
ItemPossible="*res://Autolaud/item/item_possible.gd"
CrewPossible="*res://Autolaud/crew/crewpossible.gd"
DeathLayer="*res://Autolaud/deathlayer/DeathLayer.tscn"

[input]

retry={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":82,"key_label":0,"unicode":114,"location":0,"echo":false,"script":null)
]
}
